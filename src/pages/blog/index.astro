---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="博客" description="CQL 的技术博客：转行故事、项目拆解与踩坑记录。">
  <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <p class="mb-3 font-mono text-sm text-accent">blog / 博客</p>
    <h1 class="text-3xl font-bold sm:text-4xl">博客</h1>
    <p class="mt-3 text-muted">记录学习过程与项目踩坑，让成长路径可验证。</p>

    <div class="mt-10 space-y-5">
      {
        posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="reveal block rounded-xl border border-app bg-card p-5 shadow-app transition-transform hover:-translate-y-0.5">
            <div class="flex flex-wrap items-center gap-3 text-xs text-muted">
              <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('zh-CN')}</time>
              {post.data.tags.map((tag) => (
                <span class="rounded-full bg-accent-soft px-2 py-0.5 font-mono text-accent">{tag}</span>
              ))}
            </div>
            <h2 class="mt-2 text-lg font-bold">{post.data.title}</h2>
            <p class="mt-1.5 text-sm text-muted">{post.data.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

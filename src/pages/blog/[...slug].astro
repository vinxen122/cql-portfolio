---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <p class="mb-3 font-mono text-sm text-accent">blog</p>
    <h1 class="text-3xl font-bold leading-tight sm:text-4xl">{post.data.title}</h1>
    <div class="mt-4 flex flex-wrap items-center gap-3 text-sm text-muted">
      <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('zh-CN')}</time>
      {post.data.tags.map((tag) => (
        <span class="rounded-full bg-accent-soft px-2 py-0.5 font-mono text-xs text-accent">{tag}</span>
      ))}
    </div>
    <div class="prose mt-8">
      <Content />
    </div>
    <div class="mt-12 border-t border-app pt-6 text-sm">
      <a href="/blog/" class="text-accent hover:underline">← 返回博客列表</a>
    </div>
  </article>
</BaseLayout>

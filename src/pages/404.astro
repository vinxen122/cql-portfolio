---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面不存在">
  <div class="mx-auto flex max-w-3xl flex-col items-center px-4 py-28 text-center sm:px-6">
    <p class="font-mono text-7xl font-bold text-accent">404</p>
    <h1 class="mt-4 text-2xl font-bold">页面走丢了</h1>
    <p class="mt-2 text-muted">你访问的地址不存在或已移动。</p>
    <a href="/" class="mt-6 rounded-lg bg-accent px-5 py-2.5 font-medium text-slate-950 transition-opacity hover:opacity-85">
      回到首页
    </a>
  </div>
</BaseLayout>

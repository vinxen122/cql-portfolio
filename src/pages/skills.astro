---
import BaseLayout from '../layouts/BaseLayout.astro';

const groups = [
  {
    title: '编程语言',
    items: ['Python（熟悉）', 'JavaScript / TypeScript（基础）', 'HTML / CSS（实践过）'],
  },
  {
    title: '机器学习与数据分析',
    items: ['pandas / numpy（实践过）', 'scikit-learn（学习与实践）', 'PyTorch（入门）', 'YOLOv8 目标检测（进行中）'],
  },
  {
    title: '数据与工程',
    items: ['SQL / MySQL（熟悉）', 'Git / GitHub（实践过）', 'FastAPI（学习中）', 'Linux（基础）'],
  },
  {
    title: '行业背景',
    items: ['水利工程信息化管理', 'PLC 与电气智能控制', '无人机遥感应用', 'BIM / CAD'],
  },
  {
    title: '办公与软技能',
    items: ['Excel 数据管理', '组织协调', '文档撰写', '团队合作'],
  },
];
---

<BaseLayout title="技能" description="CQL 的技能矩阵：编程、机器学习、数据工程与行业背景。">
  <div class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <p class="mb-3 font-mono text-sm text-accent">skills / 技能</p>
    <h1 class="text-3xl font-bold sm:text-4xl">技能</h1>
    <p class="mt-3 text-muted">
      等级按「熟悉 / 实践过 / 入门」如实标注，不使用虚高表述；随项目完成持续更新。
    </p>

    <div class="mt-10 space-y-8">
      {
        groups.map((group) => (
          <section class="reveal">
            <h2 class="flex items-center gap-3 text-lg font-bold">
              <span class="h-2 w-2 rounded-full bg-accent"></span>
              {group.title}
            </h2>
            <div class="mt-3 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="rounded-lg border border-app bg-card px-3 py-1.5 text-sm shadow-app">{item}</span>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

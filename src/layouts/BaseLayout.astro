---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactWidget from '../components/ContactWidget.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CQL · AI 应用工程师作品集',
  description = '曹乔量（CQL）的个人作品集网站：AI 应用工程师，专注把模型落地到水利与工业场景。',
} = Astro.props;

const pageTitle = title === 'CQL · AI 应用工程师作品集' ? title : `${title} · CQL`;
const ogImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="zh-CN" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="CQL · AI 应用工程师" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // 主题初始化：默认深色，尊重用户已保存的选择
      (function () {
        try {
          var t = localStorage.getItem('cql-theme');
          if (t === 'light') {
            document.documentElement.classList.remove('dark');
          } else {
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-app min-h-screen">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ContactWidget />
    <script>
      // 滚动渐入
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('visible');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.12 }
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('visible'));
      }
    </script>
  </body>
</html>
